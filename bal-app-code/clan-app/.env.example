# ==========================================
#  انسخ هذا الملف إلى .env وعدّل القيم
#  cp .env.example .env
# ==========================================

DATABASE_URL="postgresql://root:secretpassword@localhost:5432/clan_app_db"
MONGO_URI="mongodb://localhost:27017/clan_app_chat"
REDIS_URL="redis://localhost:6379"

PORT=3000
NODE_ENV=development

# ⚠️ ولّد قيماً عشوائية — لا تستخدم هذه في الإنتاج:
#    openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_THIS_ACCESS_SECRET_2026"
JWT_REFRESH_SECRET="CHANGE_THIS_REFRESH_SECRET_2026"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7

# نطاقات مسموحة، مفصولة بفواصل
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8081"

# ---------- Google Sign-In (المسار الأساسي) ----------
# من Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# معرّفات إضافية لتطبيقي أندرويد وآيفون، مفصولة بفواصل
GOOGLE_CLIENT_IDS="web-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com"

# ---------- مسار البريد الاحتياطي ----------
# معطَّل افتراضياً. اجعله true فقط لو تعطّل Google OAuth.
# الكود محفوظ كاملاً في auth.controller.js — لا تحذفه.
# ️ لازم true للتطوير المحلي: شاشة الدخول في bal_app بتستخدم
#    إيميل وباسورد، والسيرفر مش بيسجّل المسارات دي إلا لما يبقى true
#    (Google OAuth محتاج إعداد Cloud Console أول).
ENABLE_EMAIL_AUTH=true

# اجعلها true خلف Nginx / Heroku / Render
TRUST_PROXY=false

PG_POOL_MAX=10
METRICS_TOKEN="CHANGE_THIS_METRICS_TOKEN_IN_PRODUCTION"

# ---------- Task Check-In (POST /api/task-checkin) ----------
# سر مشترك لهوية التطبيق — يبعت في header: x-app-secret
# التطبيق بيوصّله وقت البناء: flutter run --dart-define=APP_SHARED_SECRET=...
# ولّد قيمة طويلة عشوائية: openssl rand -base64 48
APP_SHARED_SECRET="CHANGE_THIS_APP_SHARED_SECRET"
