<?xml version="1.0" encoding="utf-8"?>
<!--
════════════════════════════════════════════════════════════════
  مقتطف AndroidManifest — انسخ المحتوى داخل ملفك الحالي
════════════════════════════════════════════════════════════════

  الملف عندك:  android/app/src/main/AndroidManifest.xml

  ⚠️ لا تستبدل ملفك بهذا! انسخ الأجزاء المطلوبة فقط.
     المنطقة (أ) قبل <application>
     المنطقة (ب) داخل <application>
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════════════
         (أ) الصلاحيات — ضعها قبل وسم <application>
         ══════════════════════════════════════════════════════ -->

    <!--
      USE_EXACT_ALARM  (أندرويد 13+ / API 33+)
      يُمنح تلقائياً ولا يستطيع المستخدم سحبه.
      مخصص للتطبيقات التي المنبه وظيفتها الأساسية — وهذا حالنا.
      ⚠️ جوجل بلاي تراجع هذا الإذن. لو رفضوه استخدم SCHEDULE_EXACT_ALARM فقط.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      SCHEDULE_EXACT_ALARM  (أندرويد 12 و13 فقط)
      maxSdkVersion="32" مهم: من API 33 نعتمد على USE_EXACT_ALARM.
      جوجل تقول صراحةً: لا تطلب الاثنين معاً على نفس الجهاز.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- شاشة كاملة فوق القفل — إجباري صراحةً من API 36 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- إشعارات وقت التشغيل — أندرويد 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- إعادة الجدولة بعد إقلاع الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- إبقاء المعالج مستيقظاً أثناء الرنين -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- الاهتزاز -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- خدمة أمامية — لتشغيل الصوت دون قتل النظام لنا -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- طلب الاستثناء من تحسين البطارية -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- إيقاظ الشاشة وإظهارها فوق القفل -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />


    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <!-- ══════════════════════════════════════════════════
             (ب) المكوّنات — ضعها داخل <application>
             ══════════════════════════════════════════════════ -->

        <!--
          شاشة المنبه.

          singleInstance   : نسخة واحدة فقط — لا تتكدّس
          excludeFromRecents: لا تظهر في التطبيقات الأخيرة
          showOnLockScreen : تظهر فوق القفل (API 27+)
          turnScreenOn     : تُشعل الشاشة
          noHistory        : تُمسح فور مغادرتها
          launchMode + taskAffinity="" : مهمة منفصلة عن التطبيق
        -->
        <activity
            android:name="com.clanapp.alarm.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!--
          خدمة الرنين.

          foregroundServiceType="specialUse" إجباري من أندرويد 14.
          بدونه: MissingForegroundServiceTypeException وانهيار فوري.

          ⚠️ جوجل بلاي تسأل عن سبب specialUse عند الرفع.
             الرد المعتمد: "Alarm clock that must play audio and
             show a full-screen UI at an exact user-chosen time,
             including when the device is idle or locked."
        -->
        <service
            android:name="com.clanapp.alarm.AlarmRingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Alarm clock: plays alarm audio and shows a full-screen
                               wake-up challenge at the exact time chosen by the user,
                               including while the device is idle or locked." />
        </service>

        <!--
          المستقبِل.

          exported="true" ضروري: نيّات الإقلاع تأتي من النظام لا من تطبيقنا.
          directBootAware="true" يجعله يعمل بعد الإقلاع وقبل أول فتح للقفل.
        -->
        <receiver
            android:name="com.clanapp.alarm.AlarmReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <!--
              ⚠️⚠️  انتبه جداً  ⚠️⚠️

              الأسماء الثلاثة دي لازم تطابق ACTION_ALARM_FIRE / DISMISS / SNOOZE
              في AlarmContract.kt حرفاً بحرف.

              لو اسم حزمتك مش "com.clanapp"، غيّر الثلاثة هنا كمان.
              مثال: لو حزمتك com.hoda.clanapp تبقى
                    com.hoda.clanapp.alarm.ACTION_FIRE

              لو نسيت: الـ receiver بيستنى إشارة باسم، والكود بيبعت باسم تاني،
              فالمنبه **ما يرنش خالص** — من غير أي رسالة خطأ.
              ده أسوأ نوع بق لأنك مش هتعرف السبب.
            -->
            <intent-filter>
                <action android:name="com.clanapp.alarm.ACTION_FIRE" />
                <action android:name="com.clanapp.alarm.ACTION_DISMISS" />
                <action android:name="com.clanapp.alarm.ACTION_SNOOZE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
