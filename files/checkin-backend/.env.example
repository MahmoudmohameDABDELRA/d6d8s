# AI provider key - never commit the real value, never ship it inside the Flutter app.
AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# Server
PORT=3000

# Shared secret the Flutter app must send in a header, so random
# internet traffic can't hit your AI bill. Rotate this whenever you like.
APP_SHARED_SECRET=change-this-to-a-long-random-string
